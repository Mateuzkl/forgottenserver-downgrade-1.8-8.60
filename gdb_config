# Crash Diagnostic GDB Configuration
# On crash: prints full backtrace and exits with non-zero crash code so start.sh
# creates a database backup and restarts cleanly. Durable player state is recovered
# on startup via player_save_async_pending WAL (SaveManager::recoverPendingFlushes).
# Usage: gdb --batch -return-child-result --command=gdb_config --args ./tfs

set $_exitcode = 999
set print thread-events off
handle SIGPIPE nostop noprint pass
# Pass Ctrl+C through to the server. Without this, GDB handles SIGINT first
# and a manual shutdown can be misclassified as a crash.
handle SIGINT nostop noprint pass
run

if $_exitcode == 999
    set $_crashcode = $_exitcode

    printf "\n=== SERVER CRASH DETECTED ===\n"
    printf "Timestamp: "
    shell date "+%Y-%m-%d %H:%M:%S"
    printf "\n--- Backtrace (all threads) ---\n"
    thread apply all bt full

    # Do NOT invoke saveServer() inside a crashed process: heap/mutexes/MySQL state
    # may be corrupted and the crashing thread may not be the dispatcher thread,
    # risking corrupted writes over clean SQL WAL rows. Let restart run WAL recovery.
    printf "\n--- Crash Recovery Note ---\n"
    printf "In-process GDB save disabled for memory/DB safety; pending WAL will be recovered on restart.\n"
    printf "=== END CRASH REPORT ===\n\n"
    quit $_crashcode
end

quit $_exitcode
